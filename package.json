{
  "name": "cfr-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:up": "bun run compute-cfr -- --repos repos.json --out public/data/cfr.json && bun run dev",
    "build:dev": "tsc -b && vite build",
    "build": "tsc -b && bun run compute-cfr -- --repos repos.json --out public/data/cfr.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "compute-cfr": "bun scripts/compute-cfr.ts",
    "knip": "knip",
    "test": "vitest run && vitest run --config vitest.smoke.config.ts",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "flatted": "^3.4.3",
    "picomatch": "^2.3.2",
    "postcss": "^8.5.23",
    "react-is": "^19.2.0",
    "rollup": "^4.62.3",
    "smol-toml": "^1.7.1",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "knip": "^6.29.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  }
}
